# Aux data dir is populated by `pntmoni-pipeline acquire aux-data` from
# upstream sources (igs20.atx, igu00p01.erp). The L5copy derivation is
# reproducible from acquisition.jsonl provenance; the artefacts are
# large (~60 MB) and version-controlling them would shadow the recipe.
configs/aux_data/

# stray ssr2osr -dump outputs (should land in a workdir, not repo root)
parse_cssr_*.csv
